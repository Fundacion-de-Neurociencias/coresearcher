{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fundacion-de-Neurociencias/coresearcher/schemas/hypothesis_verification_task.schema.json",
  "title": "Hypothesis verification concordance task",
  "description": "One benchmark task. The prose arm is shown to judges; the formal arm is hidden from them. See docs/reference/benchmarks/CONCORDANCE_BENCH_PROTOCOL.md.",
  "type": "object",
  "required": ["task_id", "proposer_orcid", "licence", "confidential", "prose", "formal"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "proposer_orcid": {"type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"},
    "licence": {"type": "string"},
    "confidential": {"type": "boolean"},
    "prose": {
      "description": "Shown to judges.",
      "type": "object",
      "required": ["field", "statement", "context"],
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string"},
        "statement": {"type": "string", "minLength": 10},
        "rival_statement": {"type": "string"},
        "context": {"type": "string"},
        "observations_table": {
          "type": "object",
          "required": ["columns", "rows", "provenance"],
          "additionalProperties": false,
          "properties": {
            "columns": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Column name -> meaning."},
            "rows": {"type": "array", "items": {"type": "object"}},
            "provenance": {"type": "string", "description": "Public dataset identifier, or 'illustrative'."}
          }
        }
      }
    },
    "formal": {
      "description": "Hidden from judges.",
      "type": "object",
      "required": ["hypothesis"],
      "additionalProperties": false,
      "properties": {
        "hypothesis": {"$ref": "#/$defs/formal_hypothesis"},
        "rival": {"$ref": "#/$defs/formal_hypothesis"},
        "observations": {"type": "array", "items": {"type": "object"}},
        "proposer_expected": {"$ref": "#/$defs/answers"}
      }
    }
  },
  "$defs": {
    "formal_hypothesis": {
      "type": "object",
      "required": ["hypothesis_id", "variables", "claims"],
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {"type": "string"},
        "statement": {"type": "string"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "domain"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "domain": {"type": "array", "minItems": 1, "items": {"type": ["string", "number", "boolean"]}}
            }
          }
        },
        "scope": {"type": ["string", "null"]},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "alternatives": {"type": "array", "items": {"type": "string"}}
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Q1": {"enum": ["VACUOUS", "SELF_CONTRADICTORY", "UNFALSIFIABLE", "FALSIFIABLE"]},
        "Q2": {"enum": ["COMPATIBLE", "CONFLICTING"]},
        "Q3": {"enum": ["REFUTED", "POSSIBLY_REFUTED", "NOT_REFUTED"]},
        "Q4": {"enum": ["EQUIVALENT", "STRONGER", "WEAKER", "INCOMPARABLE", "CONTRADICTORY"]}
      }
    }
  }
}
