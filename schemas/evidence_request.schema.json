{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coresearcher.org/schemas/evidence-request.json",
  "title": "Evidence Request",
  "description": "Request for traceability analysis with full evidence grounding",
  
  "type": "object",
  "required": ["request_id", "request_type", "target", "scope"],
  
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^ER-[0-9]{6}$",
      "examples": ["ER-000042"]
    },
    
    "request_type": {
      "type": "string",
      "enum": ["CLAIM_TRACE", "EVIDENCE_GRAPH", "REPOSITORY_AUDIT", "ZENODO_CHAIN"],
      "description": "Type of traceability analysis requested",
      "examples": ["CLAIM_TRACE"]
    },
    
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["QUESTION", "ACTION", "ARTIFACT", "REPOSITORY", "DOI"],
          "description": "Type of target identifier"
        },
        "id": {
          "type": "string",
          "description": "Target identifier (e.g., QUESTION-000001, repo URL, DOI)",
          "examples": ["QUESTION-000001"]
        }
      }
    },
    
    "scope": {
      "type": "object",
      "required": ["depth"],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum hop distance from target to sources",
          "examples": [3]
        },
        "include_artifacts": {
          "type": "boolean",
          "default": true,
          "description": "Include intermediate artifacts in graph"
        },
        "include_provenance": {
          "type": "boolean",
          "default": true,
          "description": "Include full provenance metadata"
        },
        "filters": {
          "type": "object",
          "properties": {
            "min_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            },
            "classification_types": {
              "type": "array",
              "items": {"type": "string", "enum": ["observable", "derivable", "inferred"]}
            },
            "date_range": {
              "type": "object",
              "properties": {
                "from": {"type": "string", "format": "date-time"},
                "to": {"type": "string", "format": "date-time"}
              }
            }
          }
        }
      }
    },
    
    "context": {
      "type": "object",
      "description": "Optional context for interpretation",
      "properties": {
        "research_domain": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {
          "type": "string"
        }
      }
    },
    
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    
    "requested_by": {
      "type": "string",
      "description": "Agent or researcher ID making the request"
    }
  }
}