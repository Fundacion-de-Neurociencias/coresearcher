    {
      "id": "cycle.equation",
      "claim": "the cycle equation n(2^k - 3^m) = c",
      "scope": "n < 3000, four values of k",
      "status": "VERIFIED",
      "assertions": [
        {
          "assertion": "2^k T^k(n) = 3^m n + sum_j 3^(m-1-j) 2^(s_j), n < 3000, k in {1,5,17,40}",
          "holds": true
        },
        {
          "assertion": "hence a cycle (T^k(n) = n) has n (2^k - 3^m) = c > 0, so 2^k > 3^m",
          "holds": true
        },
        {
          "assertion": "trivial cycle 1 -> 2 -> 1: k = 2, m = 1, c = 1, n = 1",
          "holds": true
        }
      ],
      "values": {}
    },
    {
      "id": "cycle.product",
      "claim": "2^k/3^m = prod (1 + 1/(3x))",
      "scope": "symbolic step identity",
      "status": "VERIFIED",
      "assertions": [
        {
          "assertion": "odd step: T(x)/x = (3/2)(1 + 1/(3x))",
          "holds": true
        },
        {
          "assertion": "trivial cycle: 2^2/3^1 = 1 + 1/3",
          "holds": true
        },
        {
          "assertion": "trivial cycle: 0 < k - m log2 3 = m log2(1 + 1/(3N)) with k = 2, m = 1, N = 1",
          "holds": true
        },
        {
          "assertion": "log2(1 + 1/(3N)) is decreasing in N, so N = smallest cycle element gives the bound",
          "holds": true
        }
      ],
      "values": {}
    },
