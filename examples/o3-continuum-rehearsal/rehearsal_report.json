    ],
    "fact_sources": {
      "field == 'O3_sigma'": "abbrev Spin (n : ℕ) := ↥(Metric.sphere (0 : EuclideanSpace ℝ (Fin n)) 1); interaction = ∑ e, b e * ⟪σ e.1, σ e.2⟫ over nearest-neighbour edges; ∀ (n : ℕ), 3 ≤ n → ... (n = 3)",
      "dim == 2": "abbrev Site := ℤ × ℤ",
      "volume == 'finite_box'": "structure LatticeGraph where vertices : Finset Site; edges : Finset ...",
      "spacing == 1": "sites in ℤ × ℤ, distances by siteDistance in lattice units; no spacing parameter",
      "continuum_limit == 'none'": "no limit of any kind appears in the statement",
      "two_point_decay == 'exponential'": "correlation n G b x y ≤ A * Real.exp (-m * siteDistance x.val y.val)"
    },
    "quotes": {
      "O3-FIELD": "Spin n = unit sphere in EuclideanSpace ℝ (Fin n); ∀ n ≥ 3",
      "O3-DIM2": "abbrev Site := ℤ × ℤ",
      "O3-INFINITE-VOLUME": "vertices : Finset Site",
      "O3-CONTINUUM": "Site := ℤ × ℤ; no spacing, no limit",
      "LAT-DECAY": "0 ≤ correlation n G b x y ∧ correlation n G b x y ≤ A * Real.exp (-m * siteDistance x.val y.val)"
    },
    "notes": {
      "O3-FIELD": "The Lean statement quantifies over every n ≥ 3, so in this coordinate it is stronger than needed: n = 3 is one instance.",
      "O3-INFINITE-VOLUME": "The bound is uniform over all finite subgraphs, a volume-uniform estimate, but no infinite-volume measure is defined or asserted. lean/docs/215.md says the infinite-volume limit is not included.",
      "O3-CONTINUUM": "The object is the lattice model at unit spacing; the statement has no rescaled field (1.3), no susceptibility or correlation-length normalization and no beta -> infinity limit.",
      "O3-INTERNAL-SYMMETRY": "The lattice measure is O(n)-invariant by construction, but the statement asserts no invariance and the paper's claim is about the continuum hierarchy.",
      "O3-MASS-GAP": "Exponential decay in lattice units at fixed beta is a lattice correlation-length statement, not the continuum Hamiltonian gap of Theorem 1.2 (iii), which needs the decay in physical units uniformly as beta -> infinity.",
      "O3-NONTRIVIAL": "Nothing about four-point functions appears.",
      "LAT-DECAY": "Matches the companion paper's abstract: every n ≥ 3, every beta > 0, uniform over finite free-boundary subgraphs and edge strengths in [0, beta]."
    }
