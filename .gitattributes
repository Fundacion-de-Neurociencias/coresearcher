# Benchmark protocols are hashed; keep their bytes identical on every platform.
docs/reference/benchmarks/** text eol=lf

# Shell scripts run on Linux; CRLF would break them.
*.sh text eol=lf

# Lean files are hashed in their kernel-check logs.
*.lean text eol=lf

# Vendored third-party files are pinned by SHA-256; keep their bytes identical on every platform.
examples/local-smoothing-fidelity/LocalSmoothing.json -text
examples/o3-continuum-rehearsal/ClassicalON.json -text

# Demo artifacts carry sha256 checksums of their own bytes; never convert line endings.
integrations/oase/demo/** -text

# Regression expectations and fixtures are pinned by SHA-256 (ADR-DISCOVERY-084).
benchmarks/regression/** text eol=lf
benchmarks/regression/**/*.gz binary
