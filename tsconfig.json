{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "references": [
    { "path": "packages/types" },
    { "path": "packages/mcp-server" },
    { "path": "packages/provenance" },
    { "path": "agents/reviewer" },
    { "path": "agents/co-scientist" },
    { "path": "agents/autoscientist" },
    { "path": "agents/neurodiagnoses" }
  ]
}
