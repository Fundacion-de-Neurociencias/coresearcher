# Coresearcher Local AI and Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Local System 1 (Laya / Ollama / Local LLM)
LAYA_ENDPOINT=http://localhost:11434
LAYA_MODEL=llama3.2:3b

# Local System 2 (LM Studio / OpenAI-compatible endpoint)
LOCAL_IA_ENDPOINT=http://localhost:1234
LOCAL_IA_MODEL=local-model

# Logging and Telemetry
LOG_LEVEL=INFO
CORESEARCHER_ENV=development

# API security and networking (see api/security.py and api/server.py)
# Required for POST/PUT/DELETE endpoints; if unset, writes are refused (fail closed).
CORESEARCHER_API_KEY=
# HMAC secret configured in the GitHub webhook settings (X-Hub-Signature-256).
CORESEARCHER_GITHUB_WEBHOOK_SECRET=
# Comma-separated browser origins allowed by CORS.
CORESEARCHER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Requests per client IP per minute.
CORESEARCHER_RATE_LIMIT_PER_MINUTE=120

# Optional: path to the MetaboAD cohort CSV used by the ToolGrad suite
CORESEARCHER_COHORT_CSV=
