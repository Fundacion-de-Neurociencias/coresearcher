{
  "version": 1,
  "frozen_on": "2026-10-20",
  "note": "Frozen before any question is generated for a run. Changing this file changes the question bank hash and requires a new protocol revision.",
  "template": "Does {exposure} predict {outcome} among {population}?",
  "window": {"from": "2025-04-01", "to": "2026-10-14"},
  "domains": {
    "clinical_population_health": {
      "exposure": [
        "serum creatinine trajectory",
