        "altered microglial activation",
        "reduced synaptic gene expression",
        "aberrant splicing of the transcript",
        "epigenetic silencing of the repressor"
      ],
      "outcome": [
        "cell death",
        "tau aggregation",
        "fibrosis score",
        "lipid accumulation",
        "barrier integrity",
        "neuronal firing deficit"
